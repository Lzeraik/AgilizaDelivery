# Application
APP_NAME=AgilizaDelivery
APP_VERSION=1.0.0
DEBUG=false

# Database
DATABASE_URL=postgresql://agiliza:agiliza123@db:5432/agiliza_delivery

# JWT
SECRET_KEY=troque-esta-chave-secreta-em-producao-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin padrão (criado na primeira inicialização)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@restaurante.com
ADMIN_PASSWORD=admin123

# Frontend (para geração de QR code)
FRONTEND_URL=http://localhost:3000

# Upload de arquivos
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# NFC-e SEFAZ (preencher com dados reais)
SEFAZ_AMBIENTE=2
# 1 = Producao, 2 = Homologacao
SEFAZ_UF=SP
SEFAZ_CNPJ=00000000000000
SEFAZ_IE=000000000000
SEFAZ_RAZAO_SOCIAL=Restaurante Exemplo LTDA
SEFAZ_NOME_FANTASIA=Restaurante Exemplo
SEFAZ_LOGRADOURO=Rua Exemplo
SEFAZ_NUMERO=100
SEFAZ_BAIRRO=Centro
SEFAZ_MUNICIPIO=São Paulo
SEFAZ_CEP=01310100
SEFAZ_TELEFONE=1100000000
SEFAZ_CSC=00000000-0000-0000-0000-000000000000
SEFAZ_CSC_ID=000001
CERTIFICADO_PATH=certificado.pfx
CERTIFICADO_SENHA=senha_certificado
